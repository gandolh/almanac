{
  "name": "@almanac/server",
  "version": "0.1.0",
  "description": "The Almanac API (Fastify + SQLite).",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "vapid-keys": "tsx src/vapid-keys.ts"
  },
  "dependencies": {
    "@almanac/shared": "0.1.0",
    "@fastify/swagger": "9.9.3",
    "@fastify/type-provider-zod": "1.0.3",
    "better-sqlite3": "13.0.3",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "openapi-types": "12.1.3",
    "rrule-temporal": "2.2.8",
    "temporal-polyfill": "1.0.6",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/web-push": "3.6.4",
    "tsx": "4.23.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/testApp.d.ts",
      "default": "./dist/testing/testApp.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  }
}
