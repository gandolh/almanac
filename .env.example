# Copy to .env (gitignored). No value is ever committed.
HOST=127.0.0.1
PORT=8809
DATA_DIR=./data

# The app's own origin as the browser sees it. Default: the Vite dev server.
PUBLIC_ORIGIN=
# The API prefix and the web base as the browser sees them. These are the defaults.
# ALMANAC_API_PREFIX=/almanac-api
# ALMANAC_BASE=/almanac/

# The first user, created by `npm run seed -w @almanac/server`, which asks on the
# terminal for whatever is empty here. An existing user is left as it is.
SEED_USERNAME=
SEED_PASSWORD=

# Peers besides loopback whose X-Forwarded-For the login lockout believes:
# comma-separated addresses or CIDR ranges. Empty is right locally and on
# loopback; in a container, the network the host's proxy reaches it from
# (Docker's default is 172.16.0.0/12), or every client shares one lockout.
AUTH_TRUSTED_PROXIES=

# "Sign in with Ward" (optional): Ward's local seed.mjs fills these five. With
# WARD_OIDC_ISSUER unset the server runs with local accounts only. The key is a
# secret: never commit a value.
WARD_OIDC_ISSUER=
WARD_OIDC_CLIENT_ID=
WARD_OIDC_CLIENT_KEY=
WARD_OIDC_REDIRECT_URI=
WARD_OIDC_POST_LOGOUT_REDIRECT_URI=

# Web Push, for the Notifications dialog and event reminders (optional): all
# three, or none and notifications are off. `npm run vapid-keys -w @almanac/server`
# fills them in .env. The private key is a secret: never commit a value.
# VAPID_SUBJECT is who push services contact about this sender, a mailto: or
# https: URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
