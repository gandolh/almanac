{
  "name": "almanac",
  "version": "0.1.0",
  "description": "A personal calendar with day, week, month and year views.",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsc -b shared && concurrently --names server,web --kill-others-on-fail \"npm run dev -w @almanac/server\" \"npm run dev -w @almanac/web\"",
    "build": "tsc -b && npm run build -w @almanac/web",
    "start": "node server/dist/index.js",
    "pretest": "tsc -b shared",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p web --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "shell-quote": "1.11.0",
    "zod": "4.5.4"
  }
}
