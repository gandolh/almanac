{
  "name": "almanac",
  "version": "0.1.0",
  "description": "A personal calendar with day, week, month and year views.",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsc -b shared && concurrently --names server,web --kill-others-on-fail \"npm run dev -w @almanac/server\" \"npm run dev -w @almanac/web\"",
    "build": "tsc -b && npm run build -w @almanac/web",
    "start": "node server/dist/server.js",
    "pretest": "tsc -b shared",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p web --noEmit",
    "lint": "eslint .",
    "house-style:sync": "node vendor/house-style/bin/sync.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:conventions && npm test",
    "check:fast": "npm run typecheck && node scripts/check-fast.mjs",
    "check:conventions": "knip && depcruise server/src web/src shared/src && node vendor/house-style/bin/check-base-ui.mjs && node vendor/house-style/bin/check-structure.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.19.1",
    "@vitest/eslint-plugin": "1.6.28",
    "concurrently": "10.0.5",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.9.1",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "shell-quote": "1.11.0",
    "zod": "4.6.7"
  }
}
